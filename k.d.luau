-- Signal type for Touched events (passes BasePart to callback)
type TouchedSignal = {
	Connect: (self: TouchedSignal, fn: (BasePart) -> (), priority: number?) -> Connection,
	Once: (self: TouchedSignal, fn: (BasePart) -> ()) -> Connection,
	Wait: (self: TouchedSignal, timeout: number?) -> BasePart,
	Fire: (self: TouchedSignal, ...any) -> (),
	FireDeferred: (self: TouchedSignal, ...any) -> (),
	Destroy: (self: TouchedSignal) -> (),
}

