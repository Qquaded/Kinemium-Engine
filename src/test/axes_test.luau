local Axes = require("../environment/datatypes/Axes")

local testing = zune.testing
local expect = testing.expect

testing.describe("Axes", function()
	testing.test("Creation with all axes", function()
		local a = Axes.new(true, true, true, true, true, true, true, true, true)
		expect(a.X).toBeTruthy()
		expect(a.Y).toBeTruthy()
		expect(a.Z).toBeTruthy()
		expect(a.Top).toBeTruthy()
		expect(a.Bottom).toBeTruthy()
		expect(a.Left).toBeTruthy()
		expect(a.Right).toBeTruthy()
		expect(a.Front).toBeTruthy()
		expect(a.Back).toBeTruthy()
	end)

	testing.test("Creation defaults to false", function()
		local a = Axes.new()
		expect(a.X).toBeFalsy()
		expect(a.Y).toBeFalsy()
		expect(a.Z).toBeFalsy()
		expect(a.Top).toBeFalsy()
		expect(a.Bottom).toBeFalsy()
		expect(a.Left).toBeFalsy()
		expect(a.Right).toBeFalsy()
		expect(a.Front).toBeFalsy()
		expect(a.Back).toBeFalsy()
	end)

	testing.test("Creation with partial arguments", function()
		local a = Axes.new(true, false, true)
		expect(a.X).toBeTruthy()
		expect(a.Y).toBeFalsy()
		expect(a.Z).toBeTruthy()
		expect(a.Top).toBeFalsy()
	end)

	testing.test("ToTable and FromTable roundtrip", function()
		local a = Axes.new(true, false, true, true, false, true, false, true, false)
		local tbl = a:ToTable()
		local b = Axes.FromTable(tbl)
		expect(b.X).toBeTruthy()
		expect(b.Y).toBeFalsy()
		expect(b.Z).toBeTruthy()
		expect(b.Top).toBeTruthy()
		expect(b.Bottom).toBeFalsy()
		expect(b.Left).toBeTruthy()
		expect(b.Right).toBeFalsy()
		expect(b.Front).toBeTruthy()
		expect(b.Back).toBeFalsy()
	end)
end)
