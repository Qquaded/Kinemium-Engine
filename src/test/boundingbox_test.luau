local BoundingBox = require("../environment/datatypes/BoundingBox")
local Vector3 = require("../environment/datatypes/Vector3")

local testing = zune.testing
local expect = testing.expect

testing.describe("BoundingBox", function()
	testing.test("Creation with min and max", function()
		local bb = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 20, 30))
		expect(bb.Min.X).toBe(0)
		expect(bb.Min.Y).toBe(0)
		expect(bb.Min.Z).toBe(0)
		expect(bb.Max.X).toBe(10)
		expect(bb.Max.Y).toBe(20)
		expect(bb.Max.Z).toBe(30)
	end)

	testing.test("Creation asserts on missing args", function()
		local ok = pcall(function()
			BoundingBox.new(Vector3.new(0, 0, 0))
		end)
		expect(ok).toBeFalsy()
	end)

	testing.test("empty creates infinite bounds", function()
		local bb = BoundingBox.empty()
		expect(bb.Min.X).toBe(math.huge)
		expect(bb.Max.X).toBe(-math.huge)
	end)

	testing.test("Encapsulate expands bounds", function()
		local bb = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		bb:Encapsulate(Vector3.new(20, 20, 20))
		expect(bb.Max.X).toBe(20)
		expect(bb.Max.Y).toBe(20)
		expect(bb.Max.Z).toBe(20)
	end)

	testing.test("Contains returns true for inside point", function()
		local bb = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		expect(bb:Contains(Vector3.new(5, 5, 5))).toBeTruthy()
	end)

	testing.test("Contains returns false for outside point", function()
		local bb = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		expect(bb:Contains(Vector3.new(15, 5, 5))).toBeFalsy()
	end)

	testing.test("Contains returns true for boundary point", function()
		local bb = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		expect(bb:Contains(Vector3.new(0, 5, 5))).toBeTruthy()
		expect(bb:Contains(Vector3.new(10, 5, 5))).toBeTruthy()
	end)

	testing.test("Intersects returns true for overlapping boxes", function()
		local a = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		local b = BoundingBox.new(Vector3.new(5, 5, 5), Vector3.new(15, 15, 15))
		expect(a:Intersects(b)).toBeTruthy()
	end)

	testing.test("Intersects returns false for non-overlapping boxes", function()
		local a = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(5, 5, 5))
		local b = BoundingBox.new(Vector3.new(10, 10, 10), Vector3.new(15, 15, 15))
		expect(a:Intersects(b)).toBeFalsy()
	end)

	testing.test("Center returns midpoint", function()
		local bb = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 20, 30))
		local center = bb:Center()
		expect(center.X).toBe(5)
		expect(center.Y).toBe(10)
		expect(center.Z).toBe(15)
	end)

	testing.test("Size returns dimensions", function()
		local bb = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 20, 30))
		local size = bb:Size()
		expect(size.X).toBe(10)
		expect(size.Y).toBe(20)
		expect(size.Z).toBe(30)
	end)

	testing.test("Lerp midpoint", function()
		local a = BoundingBox.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		local b = BoundingBox.new(Vector3.new(20, 20, 20), Vector3.new(30, 30, 30))
		local l = a:Lerp(b, 0.5)
		expect(l.Min.X).toBe(10)
		expect(l.Max.X).toBe(20)
	end)

	testing.test("ToTable and FromTable roundtrip", function()
		local a = BoundingBox.new(Vector3.new(1, 2, 3), Vector3.new(10, 20, 30))
		local tbl = a:ToTable()
		local b = BoundingBox.FromTable(tbl)
		expect(b.Min.X).toBe(1)
		expect(b.Max.X).toBe(10)
	end)
end)
