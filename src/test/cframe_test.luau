local CFrame = require("../environment/datatypes/CFrame")
local Vector3 = require("../environment/datatypes/Vector3")

local testing = zune.testing
local expect = testing.expect

local function near(a, b, epsilon)
	epsilon = epsilon or 1e-5
	return math.abs(a - b) <= epsilon
end

testing.describe("CFrame", function()
	testing.test("Creation with Vector3 position", function()
		local cf = CFrame.new(Vector3.new(1, 2, 3))
		expect(cf.Position.X).toBe(1)
		expect(cf.Position.Y).toBe(2)
		expect(cf.Position.Z).toBe(3)
	end)

	testing.test("Creation with x, y, z", function()
		local cf = CFrame.new(1, 2, 3)
		expect(cf.Position.X).toBe(1)
		expect(cf.Position.Y).toBe(2)
		expect(cf.Position.Z).toBe(3)
	end)

	testing.test("Creation is identity by default", function()
		local cf = CFrame.new(0, 0, 0)
		expect(cf.Rotation[1][1]).toBe(1)
		expect(cf.Rotation[2][2]).toBe(1)
		expect(cf.Rotation[3][3]).toBe(1)
	end)

	testing.test("GetRightVector returns X axis", function()
		local cf = CFrame.new(0, 0, 0)
		local right = cf:GetRightVector()
		expect(right.X).toBe(1)
		expect(right.Y).toBe(0)
		expect(right.Z).toBe(0)
	end)

	testing.test("GetUpVector returns Y axis", function()
		local cf = CFrame.new(0, 0, 0)
		local up = cf:GetUpVector()
		expect(up.X).toBe(0)
		expect(up.Y).toBe(1)
		expect(up.Z).toBe(0)
	end)

	testing.test("GetLookVector returns negative Z axis", function()
		local cf = CFrame.new(0, 0, 0)
		local look = cf:GetLookVector()
		expect(near(look.X, 0)).toBeTruthy()
		expect(near(look.Y, 0)).toBeTruthy()
		expect(near(look.Z, -1)).toBeTruthy()
	end)

	testing.test("Inverse of identity is identity", function()
		local cf = CFrame.new(0, 0, 0)
		local inv = cf:Inverse()
		expect(inv.Position.X).toBe(0)
		expect(inv.Position.Y).toBe(0)
		expect(inv.Position.Z).toBe(0)
	end)

	testing.test("Multiplication combines transformations", function()
		local a = CFrame.new(1, 0, 0)
		local b = CFrame.new(0, 2, 0)
		local c = a * b
		expect(c.Position.X).toBe(1)
		expect(c.Position.Y).toBe(2)
	end)

	testing.test("Lerp endpoints", function()
		local a = CFrame.new(0, 0, 0)
		local b = CFrame.new(10, 20, 30)
		local l0 = a:Lerp(b, 0)
		local l1 = a:Lerp(b, 1)
		expect(l0.Position.X).toBe(0)
		expect(l1.Position.X).toBe(10)
	end)

	testing.test("Lerp midpoint", function()
		local a = CFrame.new(0, 0, 0)
		local b = CFrame.new(10, 20, 30)
		local l = a:Lerp(b, 0.5)
		expect(near(l.Position.X, 5)).toBeTruthy()
		expect(near(l.Position.Y, 10)).toBeTruthy()
		expect(near(l.Position.Z, 15)).toBeTruthy()
	end)

	testing.test("PointToWorldSpace transforms point", function()
		local cf = CFrame.new(1, 2, 3)
		local point = Vector3.new(1, 0, 0)
		local world = cf:PointToWorldSpace(point)
		expect(near(world.X, 2)).toBeTruthy()
		expect(near(world.Y, 2)).toBeTruthy()
		expect(near(world.Z, 3)).toBeTruthy()
	end)

	testing.test("PointToObjectSpace transforms point to local space", function()
		local cf = CFrame.new(1, 2, 3)
		local point = Vector3.new(2, 2, 3)
		local localPt = cf:PointToObjectSpace(point)
		expect(near(localPt.X, 1)).toBeTruthy()
		expect(near(localPt.Y, 0)).toBeTruthy()
		expect(near(localPt.Z, 0)).toBeTruthy()
	end)

	testing.test("lookAt creates CFrame facing target", function()
		local cf = CFrame.lookAt(Vector3.new(0, 0, 0), Vector3.new(0, 0, 1))
		local look = cf:GetLookVector()
		expect(near(look.Z, 1)).toBeTruthy()
	end)

	testing.test("fromAxisAngle rotates around axis", function()
		local cf = CFrame.fromAxisAngle(Vector3.new(0, 0, 1), math.pi / 2)
		local right = cf:GetRightVector()
		expect(near(right.X, 0, 1e-5)).toBeTruthy()
		expect(near(right.Y, 1, 1e-5)).toBeTruthy()
		expect(near(right.Z, 0)).toBeTruthy()
	end)

	testing.test("Angles creates rotation CFrame", function()
		local cf = CFrame.Angles(math.pi / 2, 0, 0)
		local up = cf:GetUpVector()
		expect(near(up.X, 0)).toBeTruthy()
		expect(near(up.Y, 0, 1e-5)).toBeTruthy()
		expect(near(up.Z, -1)).toBeTruthy()
	end)

	testing.test("IsClose compares CFrames", function()
		local a = CFrame.new(1, 2, 3)
		local b = CFrame.new(1.0001, 2.0001, 3.0001)
		expect(a:IsClose(b, 1e-3)).toBeTruthy()
		expect(a:IsClose(b, 1e-6)).toBeFalsy()
	end)

	testing.test("ToQuaternion roundtrips identity", function()
		local cf = CFrame.new(0, 0, 0)
		local x, y, z, w = cf:ToQuaternion()
		expect(near(w, 1)).toBeTruthy()
		expect(near(x, 0)).toBeTruthy()
		expect(near(y, 0)).toBeTruthy()
		expect(near(z, 0)).toBeTruthy()
	end)

	testing.test("GetComponents returns all values", function()
		local cf = CFrame.new(1, 2, 3)
		local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
		expect(x).toBe(1)
		expect(y).toBe(2)
		expect(z).toBe(3)
		expect(r00).toBe(1)
		expect(r11).toBe(1)
		expect(r22).toBe(1)
	end)

	testing.test("IsFinite for valid CFrame", function()
		local cf = CFrame.new(1, 2, 3)
		expect(cf:IsFinite()).toBeTruthy()
	end)

	testing.test("IsFinite for invalid CFrame", function()
		local cf = CFrame.new(math.huge, 0, 0)
		expect(cf:IsFinite()).toBeFalsy()
	end)

	testing.test("DistanceTo calculates distance", function()
		local a = CFrame.new(0, 0, 0)
		local b = CFrame.new(3, 4, 0)
		expect(near(a:DistanceTo(b), 5)).toBeTruthy()
	end)

	testing.test("ToTable and FromTable roundtrip", function()
		local a = CFrame.new(1, 2, 3)
		local tbl = a:ToTable()
		local b = CFrame.FromTable(tbl)
		expect(b.Position.X).toBe(1)
		expect(b.Position.Y).toBe(2)
		expect(b.Position.Z).toBe(3)
	end)
end)
