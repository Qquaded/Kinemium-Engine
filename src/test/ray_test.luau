local Ray = require("../environment/datatypes/Ray")
local Vector3 = require("../environment/datatypes/Vector3")

local testing = zune.testing
local expect = testing.expect

local function near(a, b, epsilon)
	epsilon = epsilon or 1e-5
	return math.abs(a - b) <= epsilon
end

testing.describe("Ray", function()
	testing.test("Creation with Vector3 origin and direction", function()
		local origin = Vector3.new(1, 2, 3)
		local direction = Vector3.new(0, 1, 0)
		local r = Ray.new(origin, direction)
		expect(r.Origin.X).toBe(1)
		expect(r.Origin.Y).toBe(2)
		expect(r.Origin.Z).toBe(3)
		expect(r.Direction.X).toBe(0)
		expect(r.Direction.Y).toBe(1)
		expect(r.Direction.Z).toBe(0)
	end)

	testing.test("Creation asserts on invalid origin", function()
		local ok = pcall(function()
			Ray.new({ 1, 2, 3 }, Vector3.new(0, 1, 0))
		end)
		expect(ok).toBeFalsy()
	end)

	testing.test("Creation asserts on invalid direction", function()
		local ok = pcall(function()
			Ray.new(Vector3.new(1, 2, 3), { 0, 1, 0 })
		end)
		expect(ok).toBeFalsy()
	end)

	testing.test("Unit normalizes direction", function()
		local r = Ray.new(Vector3.new(0, 0, 0), Vector3.new(0, 5, 0))
		local u = r:Unit()
		expect(near(u.X, 0)).toBeTruthy()
		expect(near(u.Y, 1)).toBeTruthy()
		expect(near(u.Z, 0)).toBeTruthy()
	end)

	testing.test("PointAt calculates position along ray", function()
		local r = Ray.new(Vector3.new(0, 0, 0), Vector3.new(1, 0, 0))
		local p = r:PointAt(5)
		expect(p.X).toBe(5)
		expect(p.Y).toBe(0)
		expect(p.Z).toBe(0)
	end)

	testing.test("PointAt with negative t goes backwards", function()
		local r = Ray.new(Vector3.new(5, 0, 0), Vector3.new(1, 0, 0))
		local p = r:PointAt(-3)
		expect(p.X).toBe(2)
		expect(p.Y).toBe(0)
		expect(p.Z).toBe(0)
	end)

	testing.test("DistanceToPoint calculates closest distance", function()
		local r = Ray.new(Vector3.new(0, 0, 0), Vector3.new(1, 0, 0))
		local dist = r:DistanceToPoint(Vector3.new(5, 3, 0))
		expect(near(dist, 3)).toBeTruthy()
	end)

	testing.test("DistanceToPoint returns 0 for point on ray", function()
		local r = Ray.new(Vector3.new(0, 0, 0), Vector3.new(1, 0, 0))
		local dist = r:DistanceToPoint(Vector3.new(5, 0, 0))
		expect(near(dist, 0)).toBeTruthy()
	end)

	testing.test("ToTable and FromTable roundtrip", function()
		local a = Ray.new(Vector3.new(1, 2, 3), Vector3.new(0, 1, 0))
		local tbl = a:ToTable()
		local b = Ray.FromTable(tbl)
		expect(b.Origin.X).toBe(1)
		expect(b.Origin.Y).toBe(2)
		expect(b.Origin.Z).toBe(3)
		expect(b.Direction.X).toBe(0)
		expect(b.Direction.Y).toBe(1)
		expect(b.Direction.Z).toBe(0)
	end)
end)
