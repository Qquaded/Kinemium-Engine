local Region3 = require("../environment/datatypes/Region")
local Vector3 = require("../environment/datatypes/Vector3")

local testing = zune.testing
local expect = testing.expect

testing.describe("Region3", function()
	testing.test("Creation with min and max", function()
		local r = Region3.new(Vector3.new(0, 0, 0), Vector3.new(10, 20, 30))
		expect(r.Min.X).toBe(0)
		expect(r.Min.Y).toBe(0)
		expect(r.Min.Z).toBe(0)
		expect(r.Max.X).toBe(10)
		expect(r.Max.Y).toBe(20)
		expect(r.Max.Z).toBe(30)
	end)

	testing.test("Creation normalizes swapped min/max", function()
		local r = Region3.new(Vector3.new(10, 20, 30), Vector3.new(0, 0, 0))
		expect(r.Min.X).toBe(0)
		expect(r.Max.X).toBe(10)
	end)

	testing.test("Creation asserts on missing args", function()
		local ok = pcall(function()
			Region3.new(Vector3.new(0, 0, 0))
		end)
		expect(ok).toBeFalsy()
	end)

	testing.test("Contains returns true for inside point", function()
		local r = Region3.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		expect(r:Contains(Vector3.new(5, 5, 5))).toBeTruthy()
	end)

	testing.test("Contains returns false for outside point", function()
		local r = Region3.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		expect(r:Contains(Vector3.new(15, 5, 5))).toBeFalsy()
	end)

	testing.test("Contains returns true for boundary point", function()
		local r = Region3.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		expect(r:Contains(Vector3.new(0, 5, 5))).toBeTruthy()
		expect(r:Contains(Vector3.new(10, 5, 5))).toBeTruthy()
	end)

	testing.test("ExpandToGrid expands to grid boundaries", function()
		local r = Region3.new(Vector3.new(1, 2, 3), Vector3.new(9, 18, 27))
		local expanded = r:ExpandToGrid(4)
		expect(expanded.Min.X).toBe(0)
		expect(expanded.Min.Y).toBe(0)
		expect(expanded.Min.Z).toBe(0)
		expect(expanded.Max.X).toBe(12)
		expect(expanded.Max.Y).toBe(20)
		expect(expanded.Max.Z).toBe(28)
	end)

	testing.test("Union combines two regions", function()
		local a = Region3.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		local b = Region3.new(Vector3.new(5, 5, 5), Vector3.new(15, 15, 15))
		local union = a:Union(b)
		expect(union.Min.X).toBe(0)
		expect(union.Min.Y).toBe(0)
		expect(union.Min.Z).toBe(0)
		expect(union.Max.X).toBe(15)
		expect(union.Max.Y).toBe(15)
		expect(union.Max.Z).toBe(15)
	end)

	testing.test("ToRegion3 returns self", function()
		local r = Region3.new(Vector3.new(0, 0, 0), Vector3.new(10, 10, 10))
		local converted = r:ToRegion3()
		expect(converted.Min.X).toBe(0)
		expect(converted.Max.X).toBe(10)
	end)

	testing.test("ToTable and FromTable roundtrip", function()
		local a = Region3.new(Vector3.new(1, 2, 3), Vector3.new(10, 20, 30))
		local tbl = a:ToTable()
		local b = Region3.FromTable(tbl)
		expect(b.Min.X).toBe(1)
		expect(b.Max.X).toBe(10)
	end)
end)
