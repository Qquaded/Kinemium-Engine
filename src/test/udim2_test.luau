local UDim2 = require("../environment/datatypes/UDim2")
local Vector2 = require("../environment/datatypes/Vector2")

local testing = zune.testing
local expect = testing.expect

local function near(a, b, epsilon)
	epsilon = epsilon or 1e-5
	return math.abs(a - b) <= epsilon
end

local function expectUDim2Near(a, b, epsilon)
	expect(near(a.X.Scale, b.X.Scale, epsilon)).toBeTruthy()
	expect(near(a.X.Offset, b.X.Offset, epsilon)).toBeTruthy()
	expect(near(a.Y.Scale, b.Y.Scale, epsilon)).toBeTruthy()
	expect(near(a.Y.Offset, b.Y.Offset, epsilon)).toBeTruthy()
end

testing.describe("UDim2", function()
	testing.test("Creation", function()
		local u = UDim2.new(0.5, 100, 0.25, 50)
		expect(u.X.Scale).toBe(0.5)
		expect(u.X.Offset).toBe(100)
		expect(u.Y.Scale).toBe(0.25)
		expect(u.Y.Offset).toBe(50)
	end)

	testing.test("Creation defaults to zero", function()
		local u = UDim2.new()
		expect(u.X.Scale).toBe(0)
		expect(u.X.Offset).toBe(0)
		expect(u.Y.Scale).toBe(0)
		expect(u.Y.Offset).toBe(0)
	end)

	testing.test("fromScale creates scale-only UDim2", function()
		local u = UDim2.fromScale(0.5, 0.25)
		expect(u.X.Scale).toBe(0.5)
		expect(u.X.Offset).toBe(0)
		expect(u.Y.Scale).toBe(0.25)
		expect(u.Y.Offset).toBe(0)
	end)

	testing.test("fromOffset creates offset-only UDim2", function()
		local u = UDim2.fromOffset(100, 50)
		expect(u.X.Scale).toBe(0)
		expect(u.X.Offset).toBe(100)
		expect(u.Y.Scale).toBe(0)
		expect(u.Y.Offset).toBe(50)
	end)

	testing.test("Lerp midpoint", function()
		local a = UDim2.new(0, 0, 0, 0)
		local b = UDim2.new(1, 100, 1, 100)
		local l = a:Lerp(b, 0.5)
		expect(near(l.X.Scale, 0.5)).toBeTruthy()
		expect(near(l.X.Offset, 50)).toBeTruthy()
		expect(near(l.Y.Scale, 0.5)).toBeTruthy()
		expect(near(l.Y.Offset, 50)).toBeTruthy()
	end)

	testing.test("Lerp endpoints", function()
		local a = UDim2.new(0.1, 10, 0.2, 20)
		local b = UDim2.new(0.3, 30, 0.4, 40)
		expectUDim2Near(a:Lerp(b, 0), a)
		expectUDim2Near(a:Lerp(b, 1), b)
	end)

	testing.test("Round rounds both scales and offsets", function()
		local u = UDim2.new(0.3, 10.4, 0.7, 20.6)
		local r = u:Round()
		expect(r.X.Scale).toBe(0)
		expect(r.X.Offset).toBe(10)
		expect(r.Y.Scale).toBe(1)
		expect(r.Y.Offset).toBe(21)
	end)

	testing.test("Floor floors offsets only", function()
		local u = UDim2.new(0.5, 10.6, 0.3, 20.4)
		local f = u:Floor()
		expect(f.X.Offset).toBe(10)
		expect(f.Y.Offset).toBe(20)
	end)

	testing.test("Min takes minimum of each component", function()
		local a = UDim2.new(0.5, 100, 0.3, 50)
		local b = UDim2.new(0.2, 200, 0.6, 30)
		local m = a:Min(b)
		expect(near(m.X.Scale, 0.2)).toBeTruthy()
		expect(m.X.Offset).toBe(100)
		expect(near(m.Y.Scale, 0.3)).toBeTruthy()
		expect(m.Y.Offset).toBe(30)
	end)

	testing.test("Max takes maximum of each component", function()
		local a = UDim2.new(0.5, 100, 0.3, 50)
		local b = UDim2.new(0.2, 200, 0.6, 30)
		local m = a:Max(b)
		expect(near(m.X.Scale, 0.5)).toBeTruthy()
		expect(m.X.Offset).toBe(200)
		expect(near(m.Y.Scale, 0.6)).toBeTruthy()
		expect(m.Y.Offset).toBe(50)
	end)

	testing.test("Arithmetic operators", function()
		local a = UDim2.new(0.1, 10, 0.2, 20)
		local b = UDim2.new(0.2, 20, 0.3, 30)

		local sum = a + b
		expect(near(sum.X.Scale, 0.3)).toBeTruthy()
		expect(sum.X.Offset).toBe(30)
		expect(near(sum.Y.Scale, 0.5)).toBeTruthy()
		expect(sum.Y.Offset).toBe(50)

		local diff = b - a
		expect(near(diff.X.Scale, 0.1)).toBeTruthy()
		expect(diff.X.Offset).toBe(10)
		expect(near(diff.Y.Scale, 0.1)).toBeTruthy()
		expect(diff.Y.Offset).toBe(10)

		local mul = a * 2
		expect(near(mul.X.Scale, 0.2)).toBeTruthy()
		expect(mul.X.Offset).toBe(20)
		expect(near(mul.Y.Scale, 0.4)).toBeTruthy()
		expect(mul.Y.Offset).toBe(40)

		local div = a / 2
		expect(near(div.X.Scale, 0.05)).toBeTruthy()
		expect(div.X.Offset).toBe(5)
		expect(near(div.Y.Scale, 0.1)).toBeTruthy()
		expect(div.Y.Offset).toBe(10)
	end)

	testing.test("IsZero returns true for zero UDim2", function()
		local zero = UDim2.new(0, 0, 0, 0)
		expect(zero:IsZero()).toBeTruthy()

		local nonZero = UDim2.new(0, 1, 0, 0)
		expect(nonZero:IsZero()).toBeFalsy()
	end)

	testing.test("ScaleOnly returns only scale components", function()
		local u = UDim2.new(0.5, 100, 0.25, 50)
		local s = u:ScaleOnly()
		expect(near(s.X.Scale, 0.5)).toBeTruthy()
		expect(s.X.Offset).toBe(0)
		expect(near(s.Y.Scale, 0.25)).toBeTruthy()
		expect(s.Y.Offset).toBe(0)
	end)

	testing.test("OffsetOnly returns only offset components", function()
		local u = UDim2.new(0.5, 100, 0.25, 50)
		local o = u:OffsetOnly()
		expect(o.X.Scale).toBe(0)
		expect(o.X.Offset).toBe(100)
		expect(o.Y.Scale).toBe(0)
		expect(o.Y.Offset).toBe(50)
	end)

	testing.test("Invert negates both components", function()
		local u = UDim2.new(0.5, 100, 0.25, 50)
		local i = u:Invert()
		expect(near(i.X.Scale, -0.5)).toBeTruthy()
		expect(i.X.Offset).toBe(-100)
		expect(near(i.Y.Scale, -0.25)).toBeTruthy()
		expect(i.Y.Offset).toBe(-50)
	end)

	testing.test("ToPixels calculates pixel values", function()
		local u = UDim2.new(0.5, 100, 0.25, 50)
		local ref = Vector2.new(200, 100)
		local px = u:ToPixels(ref)
		expect(px.X).toBe(200)
		expect(px.Y).toBe(75)
	end)

	testing.test("ToTable and FromTable roundtrip", function()
		local a = UDim2.new(0.25, 50, 0.5, 100)
		local tbl = a:ToTable()
		local b = UDim2.FromTable(tbl)
		expectUDim2Near(a, b)
	end)

	testing.test("__eq compares equality", function()
		local a = UDim2.new(0.5, 100, 0.25, 50)
		local b = UDim2.new(0.5, 100, 0.25, 50)
		local c = UDim2.new(0.5, 101, 0.25, 50)
		expect((a == b)).toBeTruthy()
		expect((a == c)).toBeFalsy()
	end)

	testing.test("__tostring contains UDim2", function()
		expect(string.find(tostring(UDim2.new(0.5, 100, 0.25, 50)), "UDim2", 1, true) ~= nil).toBeTruthy()
	end)
end)
